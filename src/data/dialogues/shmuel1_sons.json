    {
      "id": "s2",
      "style": "narration",
      "draft": true,
      "text_he": "טְיוּטָה",
      "text_ru": "Но не ходили сыновья его путями его: уклонились за корыстью, брали взятки и извращали суд.",
      "choices": [
        {
          "text_he": "טְיוּטָה",
          "text_ru": "Дальше",
