    {
      "id": "end",
      "style": "narration",
      "draft": true,
      "text_he": "טְיוּטָה",
      "text_ru": "Царь поднялся с престола. Всё решилось в одно мгновение. Эхуд вышел и запер за собой двери горницы.",
      "next": null
    }
