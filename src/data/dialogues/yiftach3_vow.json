    {
      "id": "v2",
      "speaker": "yiftach",
      "no_escape": true,
      "draft": true,
      "text_he": "טְיוּטָה",
      "text_ru": "Если Ты отдашь сынов Аммона в мои руки, то что выйдет из дверей моего дома мне навстречу, когда я вернусь с миром от сынов Аммона, — будет Г-споду, и я вознесу это как «олу» — всесожжение.",
      "next": "v3"
    },
    {
      "id": "v3",
      "style": "narration",
      "no_escape": true,
      "draft": true,
      "text_he": "טְיוּטָה",
      "text_ru": "Йифтах идёт к сынам Аммона.",
      "choices": [
        {
          "text_he": "טְיוּטָה",
