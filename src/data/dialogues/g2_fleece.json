    },
    {
      "id": "night2",
      "style": "narration",
      "draft": true,
      "text_he": "טְיוּטָה",
      "text_ru": "И снова ночь. Потом — утро.",
      "next": null
    },
    {
      "id": "check2",
      "speaker": "gideon",
      "draft": true,
      "text_he": "טְיוּטָה",
      "text_ru": "Утро. Вся земля мокрая от росы — а шерсть…",
      "choices": [
